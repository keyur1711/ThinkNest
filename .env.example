# ThinkNest Backend - Environment Variables (e.g. for Render)
# Copy to .env locally or set in Render Dashboard → Environment

PORT=5000
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/thinknest?retryWrites=true&w=majority
JWT_SECRET=your_secure_jwt_secret_min_32_chars
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional: frontend URL for CORS (e.g. https://thinknest.onrender.com)
# CLIENT_URL=https://your-frontend.vercel.app
